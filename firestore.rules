rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.email.matches('^[^@]+@(mail[.])?mcgill[.]ca$')
    && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
  }
  match /profiles/{uid} { allow get: if member() && request.auth.uid == uid; }
  match /matches/{id} {
   allow get: if member() && request.auth.uid in resource.data.members;
   match /contacts/{uid} {
    function paired() { return get(/databases/$(database)/documents/matches/$(id)).data; }
    allow get: if member() && request.auth.uid in paired().members
     && paired().decisions[paired().members[0]] == 'accept'
     && paired().decisions[paired().members[1]] == 'accept';
   }
  }
  // All writes, collection listing, private account/consent details, analytics,
  // reports and email jobs are server-only. Admin SDK bypasses these rules;
  // each HTTP write independently verifies the caller and validates input.
  match /{document=**} { allow read, write: if false; }
 }
}
